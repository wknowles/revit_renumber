    {
      "ConcreteType": "PythonNodeModels.PythonNode, PythonNodeModels",
      "NodeType": "PythonScriptNode",
      "Code": "# Renumber exhibition booth Rooms.\n# IN[0]=order  IN[1]=start corner  IN[2]=row tolerance (m)\n# IN[3]=prefix  IN[4]=start  IN[5]=step  IN[6]=suffix  IN[7]=digits\n# IN[8]=dry run\n#\n# Rooms are identified by category (OST_Rooms) instead of the\n# Autodesk.Revit.DB.Architecture.Room type, which some Dynamo Python engines\n# fail to resolve. Any exception is written to OUT so Dynamo shows the real\n# error instead of only \"PythonEvaluator.Evaluate failed\".\nimport traceback\n\nOUT = \"\"\n\ntry:\n    import re\n    import uuid\n\n    import clr\n\n    for assembly_name in (\"RevitAPI\", \"RevitAPIUI\", \"RevitServices\"):\n        try:\n            clr.AddReference(assembly_name)\n        except Exception:\n            pass\n\n    from Autodesk.Revit.DB import (\n        BuiltInCategory,\n        BuiltInParameter,\n        FilteredElementCollector,\n        Transaction,\n    )\n    from RevitServices.Persistence import DocumentManager\n    from RevitServices.Transactions import TransactionManager\n\n    doc = DocumentManager.Instance.CurrentDBDocument\n    uidoc = DocumentManager.Instance.CurrentUIDocument\n\n    FEET_PER_METRE = 3.280839895013123\n    MODES = (\"click\", \"rows\", \"number\")\n    CORNERS = (\"BL\", \"BR\", \"TL\", \"TR\")\n\n    def as_int(value, fallback):\n        try:\n            return int(round(float(value)))\n        except (TypeError, ValueError):\n            return fallback\n\n    def as_float(value, fallback):\n        try:\n            return float(value)\n        except (TypeError, ValueError):\n            return fallback\n\n    def as_text(value, fallback):\n        return fallback if value is None else str(value)\n\n    def format_number(value):\n        return \"{:g}\".format(value)\n\n    def format_label(prefix, number, width, suffix):\n        return \"{}{:0{}d}{}\".format(prefix, number, width, suffix)\n\n    def id_value(element_id):\n        try:\n            return element_id.Value\n        except AttributeError:\n            return element_id.IntegerValue\n\n    def element_id(element):\n        return id_value(element.Id)\n\n    room_category_id = id_value(\n        doc.Settings.Categories.get_Item(BuiltInCategory.OST_Rooms).Id\n    )\n\n    def is_room(element):\n        if element is None or element.Category is None:\n            return False\n        return id_value(element.Category.Id) == room_category_id\n\n    def number_parameter(room):\n        return room.get_Parameter(BuiltInParameter.ROOM_NUMBER)\n\n    def area_parameter(room):\n        return room.get_Parameter(BuiltInParameter.ROOM_AREA)\n\n    def room_centre(room):\n        box = room.get_BoundingBox(None)\n        if box is None:\n            return None\n        return ((box.Min.X + box.Max.X) / 2.0, (box.Min.Y + box.Max.Y) / 2.0)\n\n    def order_by_rows(rooms, corner, tolerance_m, notes):\n        tolerance = tolerance_m * FEET_PER_METRE\n        placed = []\n        for room in rooms:\n            centre = room_centre(room)\n            if centre is None:\n                notes.append(\n                    \"SKIP no bounding box, cannot order (id {})\".format(\n                        element_id(room)\n                    )\n                )\n            else:\n                placed.append((centre[1], centre[0], room))\n        if not placed:\n            return [], {}\n\n        placed.sort(key=lambda item: (item[0], item[1], element_id(item[2])))\n\n        rows = []\n        for y, x, room in placed:\n            if not rows or abs(y - rows[-1][0]) > tolerance:\n                rows.append([y, []])\n            rows[-1][1].append((x, y, room))\n\n        rows.sort(key=lambda row: row[0], reverse=corner[0] == \"T\")\n        ordered = []\n        positions = {}\n        for row_index, (_, members) in enumerate(rows, 1):\n            members.sort(\n                key=lambda item: (item[0], item[1], element_id(item[2])),\n                reverse=corner[1] == \"R\",\n            )\n            for position, (_, _, room) in enumerate(members, 1):\n                ordered.append(room)\n                positions[element_id(room)] = \"row {}, pos {}\".format(\n                    row_index, position\n                )\n        return ordered, positions\n\n    def order_by_number(rooms, notes):\n        keyed = []\n        without = []\n        for room in rooms:\n            text = number_parameter(room).AsString() or \"\"\n            match = re.search(r\"\\d+\", text)\n            if match:\n                keyed.append((int(match.group(0)), element_id(room), room))\n            else:\n                without.append(room)\n        keyed.sort(key=lambda item: (item[0], item[1]))\n        without.sort(key=element_id)\n        if without:\n            notes.append(\n                \"No number to sort by (numbered last): \"\n                + \", \".join(\"id {}\".format(element_id(room)) for room in without)\n            )\n        return [item[2] for item in keyed] + without, {}\n\n    def run():\n        order = as_text(IN[0], \"rows\").strip().lower()\n        corner = as_text(IN[1], \"BL\").strip().upper()\n        tolerance_m = as_float(IN[2], 3.0)\n        prefix = as_text(IN[3], \"\")\n        start = as_int(IN[4], 1)\n        step = as_int(IN[5], 1)\n        suffix = as_text(IN[6], \"\")\n        digits = as_int(IN[7], 3)\n        dry_run = bool(IN[8])\n\n        problems = []\n        if order not in MODES:\n            problems.append(\n                \"Order must be click, rows or number (got '{}').\".format(order)\n            )\n        if order == \"rows\":\n            if corner not in CORNERS:\n                problems.append(\n                    \"Start corner must be BL, BR, TL or TR (got '{}').\".format(corner)\n                )\n            if tolerance_m <= 0:\n                problems.append(\n                    \"Row tolerance must be greater than 0 (got {}).\".format(\n                        format_number(tolerance_m)\n                    )\n                )\n        if step < 1:\n            problems.append(\"Step must be at least 1 (got {}).\".format(step))\n        if start < 0:\n            problems.append(\"Start must be 0 or greater (got {}).\".format(start))\n        if digits < 1:\n            problems.append(\"Digits must be at least 1 (got {}).\".format(digits))\n        if problems:\n            return \"Renumber aborted:\\n  \" + \"\\n  \".join(problems)\n\n        selected = [doc.GetElement(i) for i in uidoc.Selection.GetElementIds()]\n        selected = [e for e in selected if is_room(e)]\n\n        rooms = []\n        notes = []\n        for room in selected:\n            area = area_parameter(room)\n            if area is None or area.AsDouble() <= 0:\n                notes.append(\n                    \"SKIP unplaced or zero-area room (id {})\".format(element_id(room))\n                )\n            elif number_parameter(room) is None:\n                notes.append(\n                    \"SKIP room without a Number parameter (id {})\".format(element_id(room))\n                )\n            else:\n                rooms.append(room)\n\n        if not rooms:\n            return \"Renumber: no placed Rooms in the selection. Nothing changed.\"\n\n        positions = {}\n        if order == \"rows\":\n            rooms, positions = order_by_rows(rooms, corner, tolerance_m, notes)\n            if not rooms:\n                return (\n                    \"Renumber: no selected Rooms have a bounding box. \"\n                    \"Nothing changed.\"\n                )\n        elif order == \"number\":\n            rooms, positions = order_by_number(rooms, notes)\n\n        pattern = re.compile(\"^\" + re.escape(prefix) + r\"(\\d+)\" + re.escape(suffix) + \"$\")\n\n        selected_uids = set(room.UniqueId for room in rooms)\n        occupied = set()\n        collector = FilteredElementCollector(doc)\n        collector = collector.OfCategory(BuiltInCategory.OST_Rooms)\n        collector = collector.WhereElementIsNotElementType()\n        for other in collector:\n            if other.UniqueId in selected_uids:\n                continue\n            parameter = other.get_Parameter(BuiltInParameter.ROOM_NUMBER)\n            label = (parameter.AsString() if parameter is not None else \"\") or \"\"\n            match = pattern.match(label)\n            if match:\n                occupied.add(int(match.group(1)))\n\n        cursor = start\n        numbers = []\n        skipped = []\n        for _ in rooms:\n            number = cursor\n            guard = 0\n            while number in occupied:\n                skipped.append(number)\n                number += step\n                guard += 1\n                if guard > 100000:\n                    return \"Renumber aborted: too many occupied numbers, check Start and Step.\"\n            numbers.append(number)\n            cursor = number + step\n\n        width = max([digits] + [len(str(n)) for n in numbers])\n        if width > digits:\n            notes.append(\n                \"WARN digits widened from {} to {} for a uniform label.\".format(digits, width)\n            )\n\n        labels = [format_label(prefix, n, width, suffix) for n in numbers]\n        if len(set(labels)) != len(labels):\n            return \"Renumber aborted: computed labels are not unique.\"\n\n        old_labels = [(number_parameter(room).AsString() or \"\") for room in rooms]\n\n        failed = []\n        if not dry_run:\n            TransactionManager.Instance.ForceCloseTransaction()\n\n            temp = Transaction(doc, \"Renumber rooms - temporary numbers\")\n            temp.Start()\n            token = \"ZZRN\" + uuid.uuid4().hex[:8]\n            for index, room in enumerate(rooms):\n                try:\n                    number_parameter(room).Set(\"{}-{}\".format(token, index))\n                except Exception as error:\n                    failed.append(\n                        \"FAIL temp number for id {}: {}\".format(element_id(room), error)\n                    )\n            temp.Commit()\n\n            final = Transaction(doc, \"Renumber rooms - final numbers\")\n            final.Start()\n            for room, label in zip(rooms, labels):\n                try:\n                    number_parameter(room).Set(label)\n                except Exception as error:\n                    failed.append(\n                        \"FAIL number for id {}: {}\".format(element_id(room), error)\n                    )\n            final.Commit()\n\n        lines = []\n        lines.append(\"Renumber Rooms{}\".format(\" (DRY RUN)\" if dry_run else \"\"))\n        lines.append(\n            \"prefix='{}'  start={}  step={}  suffix='{}'  digits={}\".format(\n                prefix, start, step, suffix, digits\n            )\n        )\n        if order == \"rows\":\n            lines.append(\n                \"Order: rows (corner {}, tolerance {} m), {} room(s)\".format(\n                    corner, format_number(tolerance_m), len(rooms)\n                )\n            )\n        elif order == \"number\":\n            lines.append(\"Order: existing number, {} room(s)\".format(len(rooms)))\n        else:\n            lines.append(\"Order: click order, {} room(s)\".format(len(rooms)))\n        lines.append(\"\")\n        for index, room, old, label in zip(\n            range(1, len(rooms) + 1), rooms, old_labels, labels\n        ):\n            line = \"{:>3}  id {:<10}  {:<14} -> {}\".format(\n                index, str(element_id(room)), old, label\n            )\n            position = positions.get(element_id(room))\n            if position:\n                line += \"    \" + position\n            lines.append(line)\n        if skipped:\n            lines.append(\"\")\n            lines.append(\n                \"Skipped occupied: \"\n                + \", \".join(format_label(prefix, n, width, suffix) for n in skipped)\n            )\n        if notes or failed:\n            lines.append(\"\")\n            lines.extend(notes)\n            lines.extend(failed)\n        lines.append(\"\")\n        lines.append(\n            \"{} {} room(s).\".format(\n                \"Would renumber\" if dry_run else \"Renumbered\", len(rooms)\n            )\n        )\n        return \"\\n\".join(lines)\n\n    OUT = run()\nexcept Exception:\n    OUT = \"Renumber failed:\\n\" + traceback.format_exc()\n",
      "Engine": "PythonNet3",
      "EngineName": "PythonNet3",
      "VariableInputPorts": true,
      "Id": "b82074e0601d499bbbf398201895e6f7",
